@push('scripts')
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) {
            lucide.createIcons();
        }

        // AI TERMINAL LOG ANIMATION
        const aiLog = document.getElementById('ai-log');
        if (aiLog) {
            const logs = [
                "SYSTEM_IDLE: Awaiting cognitive input...",
                "NEURAL_LINK: Established with Supradesa Node.",
                "SCANNING_DATA: Population datasets verified.",
                "AI_READY: Universal Village Intelligence online."
            ];
            let logIndex = 0;
            setInterval(() => {
                logIndex = (logIndex + 1) % logs.length;
                aiLog.style.opacity = 0;
                setTimeout(() => {
                    aiLog.innerText = logs[logIndex];
                    aiLog.style.opacity = 0.7;
                }, 500);
            }, 5000);
        }
    });
</script>
@endpush
